<div class="stt-settings-list">
    {{#each settings}}
    <div class="form-group">
        <label for="{{id}}">{{label}}</label>
        <div class="form-fields">
            {{#if choices}}
            <select id="{{id}}" name="{{key}}">
                {{#each choices as |choice|}}
                <option value="{{choice.value}}" {{#if choice.selected}}selected{{/if}}>{{choice.label}}</option>
                {{/each}}
            </select>
            {{else if number}}
            <input type="number" id="{{id}}" name="{{key}}" value="{{value}}" min="0" step="1" placeholder="—">
            {{else}}
            <input type="checkbox" id="{{id}}" name="{{key}}" {{checked value}} {{disabled disabled}}>
            {{/if}}
        </div>
        <p class="hint">{{hint}}</p>
    </div>
    {{/each}}
</div>
